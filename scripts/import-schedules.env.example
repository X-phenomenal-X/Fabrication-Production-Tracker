# Copy these into a private file on the computer that runs the weekday import.
# Do not commit the filled-in file. Do not use the service role key.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_EMAIL=tracker-import@your-company.com
SUPABASE_PASSWORD=choose-a-long-password

# Optional. The phones use "cutting".
# TRACKER_SITE=cutting

# Optional alternative to the email and password. A password is simpler:
# Supabase rotates a refresh token every time it is used.
# SUPABASE_REFRESH_TOKEN=
# SUPABASE_REFRESH_TOKEN_FILE=/home/tracker/.supabase-refresh-token
