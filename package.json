{
  "name": "bv-cutting-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Production tracker for the BV Glazing Cutting department",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run test:all",
    "test:all": "npm run test:rules && npm run test:machines && npm run test:app && npm run test:cloud && npm run test:routing && npm run test:visual && npm run build && npm run test:offline:check && npm run test:standalone:check",
    "test:rules": "node test/importer-rules-check.mjs && node test/store-rules-check.mjs",
    "test:machines": "node test/machines-check.mjs",
    "test:app": "node test/app-check.mjs",
    "test:cloud": "node test/cloud-check.mjs",
    "test:routing": "node test/routing-check.mjs",
    "test:visual": "node test/visual-qa.mjs",
    "test:standalone": "npm run build && npm run test:standalone:check",
    "test:standalone:check": "node test/standalone-check.mjs",
    "test:offline": "npm run build && npm run test:offline:check",
    "test:offline:check": "node test/offline-check.mjs",
    "serve": "node -e \"import('http').then(async({default:h})=>{const fs=await import('fs'),p=await import('path');const T={'.html':'text/html','.js':'text/javascript','.mjs':'text/javascript','.css':'text/css'};h.createServer((q,r)=>{const f=p.join(process.cwd(),q.url==='/'?'/index.html':q.url.split('?')[0]);if(!fs.existsSync(f)||fs.statSync(f).isDirectory()){r.writeHead(404);return r.end('not found')}r.writeHead(200,{'content-type':T[p.extname(f)]||'text/plain'});r.end(fs.readFileSync(f))}).listen(8000,()=>console.log('http://localhost:8000'))})\""
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "playwright": "1.50.0"
  }
}
